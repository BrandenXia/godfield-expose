{
  "manifest_version": 3,
  "name": "God Field Room Inspector",
  "version": "0.2.0",
  "description": "Show player items present in the room snapshots your God Field client receives.",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://godfield.net/*"
      ],
      "js": [
        "snapshot.js",
        "locale-hook.js",
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://godfield.net/*"
      ],
      "js": [
        "catalog.js",
        "localization.js",
        "panel.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
