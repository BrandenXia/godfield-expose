{
  "name": "godfield-room-inspector",
  "version": "0.2.1",
  "private": true,
  "description": "Inspect item data already delivered to a God Field room participant.",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node scripts/browser-test.cjs",
    "test:browser:userscript": "node scripts/browser-test.cjs --userscript",
    "test:browser:all": "node scripts/browser-test.cjs --all",
    "build:userscript": "python3 scripts/build-userscript.py",
    "check:userscript": "python3 scripts/build-userscript.py --check",
    "package": "python3 scripts/package.py"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
